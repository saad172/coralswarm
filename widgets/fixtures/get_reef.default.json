    "digest": {
      "digested_title": "Rate limiting for the public API",
      "summary": "Requests are limited per API key with a token bucket: 600 a minute, burst of 100, refilling at 10 a second. Responses over the limit return 429 with a Retry-After header. Rollout is opt-in by header until Feb 28, then default for every key.",
      "excerpts": [
        {
          "atom_id": "db9161c3-55fa-44f3-b0b2-7ee17323ca28",
          "excerpt": "Burst incident: one key at 40k/min for twelve minutes pegged the gateway. Per-IP throttling did nothing behind a NAT.",
          "contribution": "established the need"
        },
        {
          "atom_id": "ce05b4c2-cc80-4f1f-b467-64a9b4c1774f",
          "excerpt": "Decided in the platform sync: token bucket per key, 600/min, burst 100. Priya owns the ADR.",
          "contribution": "the decision itself"
        },
        {
          "atom_id": "f20d96e4-f7ef-4c80-97ff-8a533033e077",
          "excerpt": "Opt-in header gate landed in api-gateway with burst tests. 429 body shape still open.",
          "contribution": "implementation status"
        }
      ]
    },
