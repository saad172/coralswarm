{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/citations/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/lists/**",
              "components/marks/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/text/**",
              "ui_kits/app/**",
              "ui_kits/onboarding/**",
              "ui_kits/overlay/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Instrument Serif|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Instrument Serif, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|mark|key|ref|className|style|children)$/]",
        "message": "<AnswerMeta> doesn't accept that prop. Declared props: children, mark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|hue|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, hue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:coral|pink|amber|teal|plum)$/]",
        "message": "<Avatar> hue must be one of 'coral' | 'pink' | 'amber' | 'teal' | 'plum'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|outline|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailing|full|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailing, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:quiet|flush|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: quiet, flush."
